{
  "name": "windy-plugin-regate",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "ISC",
  "description": "Tracking parametrico delle flotte su Windy, Route du Rhum 2026 IMOCA",
  "scripts": {
    "build": "node scripts/configure.mjs && rollup -c && node scripts/build-meta.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "collect": "node scripts/collect.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "package:windy": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "25.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-terser": "0.4.4",
    "@windycom/plugin-devtools": "3.0.3",
    "playwright": "1.63.0",
    "rollup": "4.63.5",
    "rollup-plugin-svelte": "7.2.3",
    "rollup-plugin-swc3": "0.11.2",
    "svelte": "4.2.20",
    "svelte-check": "3.8.6",
    "svelte-preprocess": "5.1.4",
    "typescript": "5.9.3"
  }
}
